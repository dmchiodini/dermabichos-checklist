# Copie este arquivo para .env.local e preencha os valores.
# Supabase > Project Settings > API

# Públicas (podem aparecer no navegador)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETAS — nunca use o prefixo NEXT_PUBLIC_ nem faça commit destes valores.
# Chave "service_role" do Supabase (usada apenas no servidor).
SUPABASE_SERVICE_ROLE_KEY=

# Segredo para assinar a sessão do tablet (mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
